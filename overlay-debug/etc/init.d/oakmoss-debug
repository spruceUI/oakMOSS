#!/bin/sh /etc/rc.common
# oakMOSS debug image (overlay-debug): records each boot and each orderly shutdown with
# /usr/magicx/bin/oakmoss-debug.sh; the records are copied to the SD card's oakmoss-debug/.

START=12
STOP=01

start() {
	/usr/magicx/bin/oakmoss-debug.sh boot
	/usr/magicx/bin/oakmoss-debug.sh late </dev/null >/dev/null 2>&1 &
}

stop() {
	/usr/magicx/bin/oakmoss-debug.sh shutdown
}
