+#define OAKMOSS_RING_SIZE	0x100000
+#define OAKMOSS_RING_MAGIC	0x4f414b52
+#define OAKMOSS_RING_ENTRIES	((OAKMOSS_RING_SIZE - 64) / 16)
+static void __iomem *oakmoss_ring;
+static atomic_t oakmoss_ring_seq;
+
+static void oakmoss_ring_put(u32 v)
+{
+	void __iomem *e;
+	u32 seq;
+	u64 cnt;
+
+	if (!oakmoss_ring)
+		return;
+	seq = (u32)atomic_inc_return(&oakmoss_ring_seq);
+	e = oakmoss_ring + 64 + (seq % OAKMOSS_RING_ENTRIES) * 16;
