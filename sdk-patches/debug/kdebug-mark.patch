+/*
+ * oakMOSS KDEBUG_MARK, suspend path (debug kernels only, sdk-patches/debug): with
+ * oakmoss_mark= set, every device PM callback writes 0xDSxhhhhh to the mark register
+ * before it runs and again (x bit 23 set) after it returns: D = device, S = the
+ * suspend stage (kernel/power/suspend.c, 0x5A00000S), hhhhhh = FNV-1a of dev_name()
+ * masked to 23 bits (scripts/kmark-pm-decode.py maps it back to a device). A hang
+ * or reset leaves the last device that started, or finished, in the register.
+ */
+#include <linux/moduleparam.h>
+extern void oakmoss_mark(u32 v);
+static u32 oakmoss_pm_stage_cur;
+/* Which marks are written: bit 0 the stage marks, bit 1 the per-device marks. Writable at
+ * run time (/sys/module/kernel/parameters/oakmoss_pm_marks) so one kernel can tell which
+ * part changes the timing under test. */
+static unsigned int oakmoss_pm_marks = 3;
+core_param(oakmoss_pm_marks, oakmoss_pm_marks, uint, 0644);
+
+void oakmoss_pm_stage(u32 s)
+{
+	oakmoss_pm_stage_cur = s & 0xf;
+	if (oakmoss_pm_marks & 1)
+		oakmoss_mark(0x5A000000 | (s & 0xf));
+}
