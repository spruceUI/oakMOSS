+/*
+ * oakMOSS KDEBUG_MARK (debug kernels only, sdk-patches/debug): oakmoss_mark=<phys>
+ * names a 32-bit register that keeps its value through a reset and a power-off
+ * (RTC general-purpose register 5); the next boot's U-Boot reads it. oakmoss_mark()
+ * writes the whole register: each initcall its own address before it runs, the
+ * hand-off to init stages 1-6, and drivers under suspicion step codes 0x4859SSNN
+ * (Hynitron) / 0x4158SSNN (AXS15205), stored packed as DD.ss.0000 (DD the driver
+ * byte, ss = NN for init steps (SS 01), 0x80|NN for probe steps (02), 0x40|NN for
+ * reset-pulse steps (03), 0xff for the probe's error path). oakmoss_mark2() records touch-bus I2C phases (0x4931AAPP) in the low half
+ * while a driver step is current, so a hang inside a transfer still shows which step
+ * started it. Only register 5 is ever written: clearing register 4 from U-Boot as
+ * well stopped both MagicX boards in U-Boot (2026-09-18). Initcall addresses stop
+ * once init is about to run; driver steps and I2C phases go on, so a driver loaded
+ * later from userland is traced the same way.
+ */
+static phys_addr_t oakmoss_mark_phys;
+static void __iomem *oakmoss_mark_reg;
+static bool oakmoss_initcalls_done;
+static u32 oakmoss_last;
+
+static int __init oakmoss_mark_setup(char *s)
+{
+	unsigned long long v;
+
+	if (!kstrtoull(s, 0, &v))
+		oakmoss_mark_phys = v;
+	return 1;
+}
+__setup("oakmoss_mark=", oakmoss_mark_setup);
+
+static void oakmoss_mark_write(u32 v)
+{
+	if (!oakmoss_mark_phys)
+		return;
+	if (!oakmoss_mark_reg)
+		oakmoss_mark_reg = ioremap(oakmoss_mark_phys, 4);
+	if (oakmoss_mark_reg)
+		writel(v, oakmoss_mark_reg);
+	oakmoss_last = v;
+}
+
+void oakmoss_mark(u32 v)
+{
+	u32 drv = v >> 16, ss = (v >> 8) & 0xff, nn = v & 0xff;
+
+	if (drv == 0x4859 || drv == 0x4158)
+		v = (v & 0xff000000) | ((ss == 1 ? nn : ss == 3 ? 0x40 | nn :
+					    nn == 0xee ? 0xff : 0x80 | nn) << 16);
+	oakmoss_mark_write(v);
+}
+EXPORT_SYMBOL(oakmoss_mark);
+
+void oakmoss_mark2(u32 v)
+{
+	u32 d = oakmoss_last >> 24;
+
+	if (d == 0x48 || d == 0x41)
+		oakmoss_mark_write((oakmoss_last & 0xffff0000) | (v & 0xffff));
+}
+EXPORT_SYMBOL(oakmoss_mark2);
