+{
+	const char *n = dev_name(dev);
+	u32 h = 0x811c9dc5;
+
+	if (!(oakmoss_pm_marks & 2))
+		return;
+	while (n && *n)
+		h = (h ^ (u8)*n++) * 0x01000193;
+	oakmoss_mark(0xD0000000 | (oakmoss_pm_stage_cur << 24) | (after << 23) | (h & 0x7fffff));
+}
