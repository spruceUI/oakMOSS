+/* oakMOSS KDEBUG_MARK storm breaker (debug kernels only). A storm is either 50 interrupts in a
+ * row while no transfer is in flight (never legitimate), or 100 within 1 ms of the arch counter
+ * (200 kHz byte-level traffic stays under ~23 per ms). Then record the controller and transfer
+ * state (kernel log + mark 0x70bssTmm: bus, TWI status byte, xfer status, bit 7 msg != NULL,
+ * msg_idx) and switch that bus's interrupt off, so the storm ends, suspend goes on and the log
+ * can be read after the resume. */
+#include <asm/arch_timer.h>
+extern void oakmoss_mark(u32 v);
+#define OAKMOSS_STORM_BUSES 8
+static u64 oakmoss_storm_t0[OAKMOSS_STORM_BUSES];
+static unsigned int oakmoss_storm_cnt[OAKMOSS_STORM_BUSES];
+static unsigned int oakmoss_storm_idle[OAKMOSS_STORM_BUSES];
+
+static bool oakmoss_storm_check(struct sunxi_i2c *i2c, int this_irq)
+{
+	unsigned int b = i2c->bus_num;
+	u64 now = arch_counter_get_cntvct();
+	u32 stat, ctl;
+	const char *why;
+
+	if (b >= OAKMOSS_STORM_BUSES)
+		return false;
+	if (now - oakmoss_storm_t0[b] > 24000) {	/* 1 ms at 24 MHz */
+		oakmoss_storm_t0[b] = now;
+		oakmoss_storm_cnt[b] = 0;
+	}
+	oakmoss_storm_cnt[b]++;
+	if (i2c->status == I2C_XFER_IDLE)
+		oakmoss_storm_idle[b]++;
+	else
+		oakmoss_storm_idle[b] = 0;
+	if (oakmoss_storm_idle[b] >= 50)
+		why = "50 in a row with no transfer in flight";
+	else if (oakmoss_storm_cnt[b] >= 100)
+		why = "100 within 1 ms";
+	else
+		return false;
+	stat = readl(i2c->base_addr + TWI_STAT_REG);
+	ctl = readl(i2c->base_addr + TWI_CTL_REG);
+	oakmoss_mark(0x70000000 | ((b & 0xf) << 20) | ((stat & 0xff) << 12) |
+		     ((i2c->status & 0xf) << 8) | ((i2c->msg ? 1 : 0) << 7) | (i2c->msg_idx & 0x7f));
+	pr_err("oakmoss: [i2c%u] IRQ STORM (%s): stat=%#x ctl=%#x xfer_status=%d msg=%p msg_idx=%d msg_num=%d msg_ptr=%d addr=%#x -> irq %d disabled\n",
+	       b, why, stat, ctl, i2c->status, i2c->msg, i2c->msg_idx, i2c->msg_num, i2c->msg_ptr,
+	       i2c->msg ? i2c->msg[0].addr : 0, this_irq);
+	twi_disable_irq(i2c->base_addr);
+	disable_irq_nosync(this_irq);
+	oakmoss_storm_idle[b] = 0;
+	oakmoss_storm_cnt[b] = 0;
+	return true;
+}
