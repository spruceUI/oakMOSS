# KDEBUG_HANG=1 (scripts/build.sh, part of KDEBUG_IMAGE): lockup and hung-task detectors and a 5 s
# panic timeout replace three OFF lines of config-4.9; every prompt they open is answered here
# (conf --olddefconfig with KDEBUG_FTRACE, 2026-10-07). The panics are switched on at run time.
CONFIG_LOCKUP_DETECTOR=y
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC_VALUE=0
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
CONFIG_BOOTPARAM_HUNG_TASK_PANIC_VALUE=0
CONFIG_PANIC_TIMEOUT=5
