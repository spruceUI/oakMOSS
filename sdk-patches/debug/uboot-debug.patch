+	strcat(cmdline, tmpbuf);
+	oakmoss_reg_arg(tmpbuf, "pwroff", oakmoss_pwroff_raw);
+	strcat(cmdline, tmpbuf);
+	oakmoss_reg_arg(tmpbuf, "f0", oakmoss_f0_raw);
+	strcat(cmdline, tmpbuf);
+	snprintf(tmpbuf, 128, " oakmoss.src=%d oakmoss.chg=%lu oakmoss.axpinfo=%d oakmoss.logo=%d",
+		 gd->pmu_saved_status, gd->chargemode, oakmoss_axp_info_ran, gd->boot_logo_addr ? 1 : 0);
+	strcat(cmdline, tmpbuf);
+	snprintf(tmpbuf, 128, " oakmoss.prev_mark=0x%08x oakmoss_mark=0x%08x",
+		 oakmoss_prev_mark, OAKMOSS_MARK_REG);
+	strcat(cmdline, tmpbuf);
+	writel(0x75000002, (void *)(uintptr_t)OAKMOSS_MARK_REG);	/* U-Boot: booting the kernel */
 
