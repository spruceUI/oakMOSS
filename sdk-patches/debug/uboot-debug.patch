diff -ruN a/lichee/brandy-2.0/u-boot-2018/board/sunxi/sunxi_bootargs.c b/lichee/brandy-2.0/u-boot-2018/board/sunxi/sunxi_bootargs.c
--- a/lichee/brandy-2.0/u-boot-2018/board/sunxi/sunxi_bootargs.c
+++ b/lichee/brandy-2.0/u-boot-2018/board/sunxi/sunxi_bootargs.c
@@ -11,8 +11,40 @@
 #include <boot_gui.h>
 #include <sys_partition.h>
 #include <sunxi_verify_boot_info.h>
+#include <asm/io.h>
+#include <sunxi_power/axp.h>
 DECLARE_GLOBAL_DATA_PTR;
 
+/*
+ * oakMOSS debug U-Boot (sdk-patches/debug/uboot-debug.patch, debug images only): the PMIC
+ * registers behind the boot-mode decision and the last mark the previous boot left in RTC
+ * general-purpose register 5 go to Linux as oakmoss.* arguments; register 4 is never touched.
+ */
+#define OAKMOSS_MARK_REG	0x07000114
+int oakmoss_pwron_raw = -1;	/* PWRON_STATUS (0x20) as bmu_axp2202_get_poweron_source() read it */
+int oakmoss_axp_info_ran;	/* sunxi_update_axp_info() ran, so the charge-mode check was made */
+static int oakmoss_pwroff_raw = -1, oakmoss_f0_raw = -1, oakmoss_captured;
+static u32 oakmoss_prev_mark;
+
+/* Once, from board_init() (or update_bootargs() if the PMIC probe failed there). */
+void oakmoss_debug_capture(void)
+{
+	if (oakmoss_captured++)
+		return;
+	oakmoss_pwroff_raw = pmu_get_reg_value(0x21);
+	oakmoss_f0_raw = pmu_get_reg_value(0xf0);
+	oakmoss_prev_mark = readl((void *)(uintptr_t)OAKMOSS_MARK_REG);
+	writel(0x75000001, (void *)(uintptr_t)OAKMOSS_MARK_REG);	/* U-Boot: board_init */
+}
+
+static void oakmoss_reg_arg(char *out, const char *name, int v)
+{
+	if (v < 0)
+		sprintf(out, " oakmoss.%s=none", name);
+	else
+		sprintf(out, " oakmoss.%s=0x%02x", name, v);
+}
+
 #ifdef CONFIG_SUNXI_USER_KEY
 char *IGNORE_ENV_VARIABLE[] = {
 	"console",    "root",    "init",	   "loglevel",
@@ -319,6 +351,22 @@
 		strcat(cmdline, tmpbuf);
 	}
 #endif
+
+	/* oakMOSS debug U-Boot: boot-mode inputs, the previous boot's last mark, marks on */
