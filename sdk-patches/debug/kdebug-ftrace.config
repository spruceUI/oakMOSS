# KDEBUG_FTRACE=1 (scripts/build.sh): replaces '# CONFIG_FTRACE is not set' in the kernel's
# config-4.9 with this block. Every symbol FTRACE makes visible is answered here, all
# members of the branch-profiling choice included: the kernel is configured through
# silentoldconfig with stdin redirected, so one unanswered NEW prompt aborts the build.
# Resolved with 'make ARCH=arm64 olddefconfig' on config-4.9 plus FTRACE, FUNCTION_TRACER
# and DYNAMIC_FTRACE (2026-09-24). Debug cards only; build.sh removes it again otherwise.
CONFIG_BINARY_PRINTF=y
# CONFIG_BLK_DEV_IO_TRACE is not set
CONFIG_BRANCH_PROFILE_NONE=y
CONFIG_CONTEXT_SWITCH_TRACER=y
# CONFIG_DEBUG_PAGE_REF is not set
CONFIG_DYNAMIC_FTRACE=y
CONFIG_EVENT_TRACING=y
CONFIG_FTRACE_MCOUNT_RECORD=y
# CONFIG_FTRACE_STARTUP_TEST is not set
# CONFIG_FTRACE_SYSCALLS is not set
CONFIG_FTRACE=y
CONFIG_FUNCTION_GRAPH_TRACER=y
# CONFIG_FUNCTION_PROFILER is not set
CONFIG_FUNCTION_TRACER=y
CONFIG_GENERIC_TRACER=y
# CONFIG_HWLAT_TRACER is not set
# CONFIG_IRQSOFF_TRACER is not set
CONFIG_MODULES_TREE_LOOKUP=y
# CONFIG_NET_DROP_MONITOR is not set
CONFIG_NOP_TRACER=y
# CONFIG_PREEMPTIRQ_EVENTS is not set
# CONFIG_PREEMPT_TRACER is not set
# CONFIG_PROBE_EVENTS is not set
# CONFIG_PROFILE_ALL_BRANCHES is not set
# CONFIG_PROFILE_ANNOTATED_BRANCHES is not set
# CONFIG_PSTORE_FTRACE is not set
# CONFIG_RING_BUFFER_BENCHMARK is not set
# CONFIG_RING_BUFFER_STARTUP_TEST is not set
CONFIG_RING_BUFFER=y
# CONFIG_SCHED_TRACER is not set
# CONFIG_STACK_TRACER is not set
CONFIG_TRACE_CLOCK=y
# CONFIG_TRACE_ENUM_MAP_FILE is not set
# CONFIG_TRACEPOINT_BENCHMARK is not set
CONFIG_TRACEPOINTS=y
# CONFIG_TRACER_SNAPSHOT is not set
CONFIG_TRACING_EVENTS_GPIO=y
CONFIG_TRACING=y
