+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AXS15205 capacitive touch panel controller (I2C), as fitted to the
+ * MagicX Zero 40 (480x800 panel, controller at twi1 address 0x3b, INT PB6).
+ *
+ * A trimmed port of the AiXieSheng "axs_ts" driver family (V2.x) to this
+ * 4.9 tree, kept to what the Zero 40's stock kernel actually does with the
+ * chip (read back from that kernel's axs_ts_probe / axs_ts_interrupt):
+ *
+ *   - probe: INT pin from touch,irq-gpio, 120 ms for the panel to come up,
+ *     firmware version through register 0x0c (write 1 byte, read 2), input
+ *     device "axs_ts" with 5 type-B slots on 480x800, pressure + touch major;
+ *   - interrupt: one plain i2c_master_recv() of a 32-byte frame, no command
+ *     prefix and no checksum;
+ *   - frame: [0] gesture/status (low 6 bits must be 0), [1] low nibble =
+ *     contact count (high nibble = status, must be 0), then 6 bytes per
+ *     contact from offset 2: event(7:6)|x_hi(3:0), x_lo, id(7:4)|y_hi(3:0),
+ *     y_lo, weight, area(7:4); event 0 = down, 1 = up, 2 = contact.
+ *
+ * Firmware download/upgrade, gesture, ESD and sysfs/proc debug paths of the
+ * original are not carried.
+ *
+ * Device tree (child of the TWI the panel hangs off):
+ *
+ *   cap_touch@3b {
+ *       compatible = "axs15205,axs15205_touch";
+ *       reg = <0x3b>;
+ *       touch,irq-gpio = <&pio PB 6 6 0xffffffff 0xffffffff 0>;
+ *       touch,reset-gpio = <...>;        optional (the Zero 40 has none: the
+ *                                        panel's reset line resets the chip)
+ *       touchscreen-size-x = <480>;      optional, default 480
+ *       touchscreen-size-y = <800>;      optional, default 800
+ *       touchscreen-inverted-x;          optional
+ *       touchscreen-inverted-y;          optional
+ *       touchscreen-swapped-x-y;         optional
+ *   };
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/slab.h>
+
+#define AXS_NAME		"axs_ts"
+#define AXS_MAX_POINTS		5
+#define AXS_POINT_LEN		6
+#define AXS_FRAME_LEN		32	/* what the stock kernel reads per interrupt */
+#define AXS_REG_VERSION		0x0c
+
+#define AXS_EV_DOWN		0
+#define AXS_EV_UP		1
+#define AXS_EV_CONTACT		2
+
+struct axs15205 {
+	struct i2c_client *client;
+	struct input_dev *input;
+	int irq_gpio;
+	int reset_gpio;
+	int irq;
+	u32 max_x, max_y;
+	bool invert_x, invert_y, swap_xy;
+	u8 frame[AXS_FRAME_LEN];
+};
+
+static int axs_read_frame(struct axs15205 *ts)
+{
+	int ret;
+
+	memset(ts->frame, 0xff, sizeof(ts->frame));
+	ret = i2c_master_recv(ts->client, ts->frame, sizeof(ts->frame));
+	if (ret < 0)
+		return ret;
+	return ret == sizeof(ts->frame) ? 0 : -EIO;
+}
+
+static int axs_read_version(struct axs15205 *ts, u8 *ver)
+{
+	u8 reg = AXS_REG_VERSION;
+	u8 val[2] = { 0, 0 };
+	struct i2c_msg msgs[2] = {
+		{ .addr = ts->client->addr, .flags = 0, .len = 1, .buf = &reg },
+		{ .addr = ts->client->addr, .flags = I2C_M_RD, .len = 2, .buf = val },
+	};
+	int ret;
+
+	ret = i2c_transfer(ts->client->adapter, msgs, 2);
+	if (ret < 0)
+		return ret;
+	if (ret != 2)
+		return -EIO;
+	ver[0] = val[0];
+	ver[1] = val[1];
+	return 0;
+}
+
+static void axs_report(struct axs15205 *ts)
+{
+	struct input_dev *input = ts->input;
+	const u8 *f = ts->frame;
+	int n, i;
+
+	if (f[0] & 0x3f)		/* gesture / status frame: nothing to report */
+		return;
+	if (f[1] >> 4)			/* ESD / status nibble set */
+		return;
+	n = f[1] & 0x0f;
+	if (n == 0)
+		return;
+	if (n > AXS_MAX_POINTS)
+		n = AXS_MAX_POINTS;
+
+	for (i = 0; i < n; i++) {
+		const u8 *p = f + 2 + i * AXS_POINT_LEN;
+		unsigned int id = p[2] >> 4;
+		unsigned int ev = p[0] >> 6;
+		unsigned int x = ((p[0] & 0x0f) << 8) | p[1];
+		unsigned int y = ((p[2] & 0x0f) << 8) | p[3];
+		unsigned int weight = p[4];
+		unsigned int area = p[5] >> 4;
+
+		if (id >= AXS_MAX_POINTS)
+			break;
+		if (ts->swap_xy)
+			swap(x, y);
+		if (ts->invert_x)
+			x = ts->max_x - min(x, ts->max_x);
+		if (ts->invert_y)
+			y = ts->max_y - min(y, ts->max_y);
+
+		input_mt_slot(input, id);
+		if (ev == AXS_EV_DOWN || ev == AXS_EV_CONTACT) {
+			input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+			input_report_abs(input, ABS_MT_PRESSURE, weight ? weight : 0x3f);
+			input_report_abs(input, ABS_MT_TOUCH_MAJOR, area ? area : 0x09);
+			input_report_abs(input, ABS_MT_POSITION_X, x);
+			input_report_abs(input, ABS_MT_POSITION_Y, y);
+		} else {
+			input_mt_report_slot_state(input, MT_TOOL_FINGER, false);
+		}
+	}
+	input_mt_sync_frame(input);
+	input_sync(input);
+}
+
+static irqreturn_t axs_irq(int irq, void *dev_id)
+{
+	struct axs15205 *ts = dev_id;
+
+	if (axs_read_frame(ts) == 0)
+		axs_report(ts);
+	return IRQ_HANDLED;
+}
+
+static void axs_release_all(struct axs15205 *ts)
+{
+	int i;
+
+	for (i = 0; i < AXS_MAX_POINTS; i++) {
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, false);
+	}
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static int axs_parse_dt(struct axs15205 *ts)
+{
+	struct device *dev = &ts->client->dev;
+	struct device_node *np = dev->of_node;
+
+	if (!np)
+		return -ENODEV;
+	ts->irq_gpio = of_get_named_gpio(np, "touch,irq-gpio", 0);
+	if (!gpio_is_valid(ts->irq_gpio)) {
+		dev_err(dev, "touch,irq-gpio missing or invalid (%d)\n", ts->irq_gpio);
+		return -EINVAL;
+	}
+	ts->reset_gpio = of_get_named_gpio(np, "touch,reset-gpio", 0);
+	ts->max_x = 480;
+	ts->max_y = 800;
+	of_property_read_u32(np, "touchscreen-size-x", &ts->max_x);
+	of_property_read_u32(np, "touchscreen-size-y", &ts->max_y);
+	ts->invert_x = of_property_read_bool(np, "touchscreen-inverted-x");
+	ts->invert_y = of_property_read_bool(np, "touchscreen-inverted-y");
+	ts->swap_xy = of_property_read_bool(np, "touchscreen-swapped-x-y");
+	return 0;
+}
+
+static int axs_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+	struct device *dev = &client->dev;
+	struct axs15205 *ts;
+	struct input_dev *input;
+	u8 ver[2];
+	int ret, retry;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C)) {
+		dev_err(dev, "adapter lacks I2C_FUNC_I2C\n");
+		return -ENODEV;
+	}
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+
+	ret = axs_parse_dt(ts);
+	if (ret)
+		return ret;
+
+	ret = devm_gpio_request_one(dev, ts->irq_gpio, GPIOF_IN, "axs15205_irq");
+	if (ret) {
+		dev_err(dev, "irq gpio %d request failed (%d)\n", ts->irq_gpio, ret);
+		return ret;
+	}
+	ts->irq = gpio_to_irq(ts->irq_gpio);
+	if (ts->irq < 0) {
+		dev_err(dev, "gpio %d has no irq (%d)\n", ts->irq_gpio, ts->irq);
+		return ts->irq;
+	}
+
+	if (gpio_is_valid(ts->reset_gpio)) {
+		ret = devm_gpio_request_one(dev, ts->reset_gpio, GPIOF_OUT_INIT_HIGH,
+					    "axs15205_reset");
+		if (ret) {
+			dev_err(dev, "reset gpio %d request failed (%d)\n", ts->reset_gpio, ret);
+			return ret;
+		}
+		usleep_range(1000, 1100);
+		gpio_set_value(ts->reset_gpio, 0);
+		usleep_range(10000, 11000);
+		gpio_set_value(ts->reset_gpio, 1);
+	}
+	/* The stock driver waits this long for the panel (which resets the chip)
+	 * to finish its own init before touching the controller. */
+	msleep(120);
+
+	for (retry = 0; retry < 3; retry++) {
+		ret = axs_read_version(ts, ver);
+		if (ret == 0)
+			break;
+		msleep(20);
+	}
+	if (ret)
+		dev_warn(dev, "firmware version read failed (%d); continuing\n", ret);
+	else
+		dev_info(dev, "firmware version %02x%02x at 0x%02x, irq gpio %d\n",
+			 ver[0], ver[1], client->addr, ts->irq_gpio);
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+	ts->input = input;
+	input->name = AXS_NAME;
+	input->id.bustype = BUS_I2C;
+	input->dev.parent = dev;
+
+	__set_bit(EV_SYN, input->evbit);
+	__set_bit(EV_ABS, input->evbit);
+	__set_bit(EV_KEY, input->evbit);
+	__set_bit(BTN_TOUCH, input->keybit);
+	__set_bit(BTN_TOOL_FINGER, input->keybit);
+	__set_bit(INPUT_PROP_DIRECT, input->propbit);
+	input_set_abs_params(input, ABS_X, 0, ts->max_x, 0, 0);
+	input_set_abs_params(input, ABS_Y, 0, ts->max_y, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0, ts->max_x, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0, ts->max_y, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, 0xff, 0, 0);
+	input_set_abs_params(input, ABS_MT_PRESSURE, 0, 0xff, 0, 0);
+	ret = input_mt_init_slots(input, AXS_MAX_POINTS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+	ret = input_register_device(input);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, ts->irq, NULL, axs_irq,
+					IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+					AXS_NAME, ts);
+	if (ret) {
+		dev_err(dev, "irq %d request failed (%d)\n", ts->irq, ret);
+		return ret;
+	}
+	dev_info(dev, "%s: %ux%u, %d slots, irq %d\n", AXS_NAME, ts->max_x, ts->max_y,
+		 AXS_MAX_POINTS, ts->irq);
+	return 0;
+}
+
+static int axs_remove(struct i2c_client *client)
+{
+	return 0;
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int axs_suspend(struct device *dev)
+{
+	struct axs15205 *ts = i2c_get_clientdata(to_i2c_client(dev));
+
+	disable_irq(ts->irq);
+	axs_release_all(ts);
+	return 0;
+}
+
+static int axs_resume(struct device *dev)
+{
+	struct axs15205 *ts = i2c_get_clientdata(to_i2c_client(dev));
+
+	enable_irq(ts->irq);
+	return 0;
+}
+#endif
+
+static SIMPLE_DEV_PM_OPS(axs_pm_ops, axs_suspend, axs_resume);
+
+static const struct of_device_id axs_of_match[] = {
+	{ .compatible = "axs15205,axs15205_touch" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, axs_of_match);
+
+static const struct i2c_device_id axs_id[] = {
+	{ AXS_NAME, 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, axs_id);
+
+static struct i2c_driver axs_driver = {
+	.driver = {
+		.name = AXS_NAME,
+		.of_match_table = axs_of_match,
+		.pm = &axs_pm_ops,
+	},
+	.probe = axs_probe,
+	.remove = axs_remove,
+	.id_table = axs_id,
+};
+
+static int __init axs_init(void)
+{
+	return i2c_add_driver(&axs_driver);
+}
+/* After the display driver: the panel's reset line is what resets the chip. */
+late_initcall(axs_init);
+
+static void __exit axs_exit(void)
+{
+	i2c_del_driver(&axs_driver);
+}
+module_exit(axs_exit);
+
+MODULE_DESCRIPTION("AXS15205 touch panel driver (MagicX Zero 40)");
+MODULE_LICENSE("GPL v2");
