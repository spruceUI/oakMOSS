+static int cst8xx_bootloader_enter(struct i2c_client *client) {
+	char retryCnt = 10;
+	HYN_FUNC_ENTER();
+
+	hyn_reset_proc(1);
+	mdelay(5);
+	if (hyn_ts_data->chip_ic_bootloader_addr != client->addr) {
+		client->addr = hyn_ts_data->chip_ic_bootloader_addr;
+	}
+	HYN_DEBUG(" bootloader mode client->addr:0x%x.\r\n", client->addr);
+	while (retryCnt--) {
+		u8 cmd[3];
+		cmd[0] = 0xAA;
+		if (-1 ==
+		    hyn_i2c_write_bytes(0xA001, cmd, 1,
+					REG_LEN_2B)) { // enter program mode
+			mdelay(2);		       // 4ms
+			continue;
+		}
+		if (-1 == hyn_i2c_read_bytes(0xA003, cmd, 1,
+					     REG_LEN_2B)) { // read flag
+			mdelay(2);			    // 4ms
+			continue;
+		} else {
+			if (cmd[0] != 0x55) {
+				mdelay(2); // 4ms
+				continue;
+			} else {
+				HYN_DEBUG("cst8xx_bootloader_enter detect "
+					  "success, cmd[0]=%d.\n",
+					  cmd[0]);
+				return 0;
+			}
+		}
+	}
+
+	HYN_FUNC_EXIT();
+	return -1;
+}
