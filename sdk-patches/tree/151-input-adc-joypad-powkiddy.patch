diff -ruN a/lichee/linux-4.9/drivers/input/joystick/Kconfig b/lichee/linux-4.9/drivers/input/joystick/Kconfig
--- a/lichee/linux-4.9/drivers/input/joystick/Kconfig	2024-12-15 20:26:26
+++ b/lichee/linux-4.9/drivers/input/joystick/Kconfig	2026-10-23 16:44:51
@@ -330,4 +330,13 @@
 	  To compile this as a module choose M here: the module will be called
 	  maplecontrol.
 
+config JOYSTICK_ADC_JOYPAD
+	tristate "GPIO and GPADC gamepad (Powkiddy V90S and V20)"
+	depends on ARCH_SUNXI && OF_GPIO && SENSORS_GPADC
+	default y
+	help
+	  The pad of the Powkiddy V90S and V20 in their stock device tree's
+	  "adc-joypad" binding: buttons on GPIOs, sticks behind an analog
+	  multiplexer on one GPADC channel, rumble on a PWM channel.
+
 endif
