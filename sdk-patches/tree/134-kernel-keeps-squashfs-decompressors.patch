--- a/build/kernel-defaults.mk
+++ b/build/kernel-defaults.mk
@@ -102,7 +102,10 @@
 endif
 
 # copy CONFIG_KERNEL_* settings over to .config.target
-	awk '/^(#[[:space:]]+)?CONFIG_KERNEL/{sub("CONFIG_KERNEL_","CONFIG_");print}' $(TOPDIR)/.config >> $(LINUX_DIR)/.config.target
+# oakMOSS (sdk-patches/tree/134): KERNEL_SQUASHFS_{XZ,LZ4,ZLIB} are one choice, the rootfs
+# image's compressor. Copied as they were, the two it did not pick came last and switched
+# those decompressors off whatever config-4.9 said; skipping them leaves that to config-4.9.
+	awk '/^#[[:space:]]+CONFIG_KERNEL_SQUASHFS_(XZ|LZ4|LZO|ZLIB) is not set/{next} /^(#[[:space:]]+)?CONFIG_KERNEL/{sub("CONFIG_KERNEL_","CONFIG_");print}' $(TOPDIR)/.config >> $(LINUX_DIR)/.config.target
 	echo "# CONFIG_KALLSYMS_EXTRA_PASS is not set" >> $(LINUX_DIR)/.config.target
 	echo "# CONFIG_KALLSYMS_ALL is not set" >> $(LINUX_DIR)/.config.target
 	echo "CONFIG_KALLSYMS_UNCOMPRESSED=y" >> $(LINUX_DIR)/.config.target
