-    CONFIG_LIBC_FILE_SPEC="./lib/ld-linux-aarch64.so.1 ./lib/libc.so ./lib/lib{anl,c,crypt,dl,m,mvec,nsl,nss_compat,nss_dns,nss_files,resolv,util,BrokenLocale,thread_db,c_malloc_debug}.so.*"
+    CONFIG_LIBC_FILE_SPEC="./lib/ld-linux-aarch64.so.1 ./lib/libc.so ./lib/lib{anl,c,crypt,dl,gomp,m,mvec,nsl,nss_compat,nss_dns,nss_files,resolv,util,BrokenLocale,thread_db,c_malloc_debug}.so.*"
