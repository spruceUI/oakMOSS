--- a/package/libs/zlib/Makefile
+++ b/package/libs/zlib/Makefile
@@ -7,13 +7,22 @@
 
 include $(TOPDIR)/rules.mk
 
+# oakMOSS (sdk-patches/tree/135): zlib 1.2.8 -> 1.3.1. 1.2.8 lacks the functions
+# zlib 1.2.9 added (inflateValidate, uncompress2, gzfread, crc32_z, ...). libpng 1.6
+# builds on the spruce card and in PortMaster ports import inflateValidate, and the
+# ones linked -z now do not start against 1.2.8. 1.3.1 is the release Debian 13 and
+# Ubuntu 26.04 ship and keeps every earlier libz.so.1 function. LDSHARED below still
+# leaves out zlib's --version-script, as the SDK built 1.2.8, so the library stays
+# unversioned and binds as it did. scripts/lib.sh pins the tarball (ZLIB_*),
+# fetch-inputs.sh downloads it and apply-sdk-mods.sh stages it into dl/, so no build
+# downloads.
 PKG_NAME:=zlib
-PKG_VERSION:=1.2.8
+PKG_VERSION:=1.3.1
 PKG_RELEASE:=1
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
-PKG_SOURCE_URL:=http://www.zlib.net @SF/libpng
-PKG_MD5SUM:=44d667c142d7cda120332623eab69f40
+PKG_SOURCE_URL:=https://zlib.net/fossils https://github.com/madler/zlib/releases/download/v$(PKG_VERSION)
+PKG_HASH:=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
 
 PKG_LICENSE:=Zlib
 PKG_LICENSE_FILES:=README
