+/*
+ * oakMOSS (sdk-patches/tree/163): a normal boot is "run [<var> ...] <tail>", so the own lane's
+ * "run oakroot_${root_partition} setargs_mmc boot_normal" passes androidboot.mode as the SDK's does.
+ */
+static int oakmoss_boot_normal(const char *cmd, const char *tail)
+{
+	size_t n, t = strlen(tail);
+
+	if (!cmd || strncmp(cmd, "run ", 4))
+		return 0;
+	n = strlen(cmd);
+	return n >= 4 + t && cmd[n - t - 1] == ' ' && !strcmp(cmd + n - t, tail);
+}
