--- a/lichee/linux-4.9/drivers/video/fbdev/sunxi/disp2/disp/lcd/rtp40wv101b.c	2026-09-16 15:28:27.455929471 -0500
+++ b/lichee/linux-4.9/drivers/video/fbdev/sunxi/disp2/disp/lcd/rtp40wv101b.c	2026-09-16 17:30:56.793116197 -0500
@@ -0,0 +1,171 @@
+/* drivers/video/fbdev/sunxi/disp2/disp/lcd/rtp40wv101b.c
+ *
+ * RTP40WV101B: 480x800, two-lane MIPI-DSI, the panel of the MagicX Zero 40.
+ *
+ * Recovered from the board's stock kernel (MagicX's public Zero40_V1 adb image, kernel
+ * 4.9.170 "#18 SMP PREEMPT Mon Jun 16 2025"): the open/close flows, the power and reset
+ * sequence and the DSI init (sleep out, display on) were read out of that binary's
+ * lcd_open_flow / lcd_power_on / lcd_panel_init / lcd_panel_exit /
+ * lcd_power_off routines and are reproduced here call for call, delays
+ * included. The panel timings live in the board device tree (lcd0), also
+ * taken from the stock tree. Gamma/cmap setup is the SDK's standard one.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+#include "rtp40wv101b.h"
+
+static void lcd_power_on(u32 sel);
+static void lcd_power_off(u32 sel);
+static void lcd_bl_open(u32 sel);
+static void lcd_bl_close(u32 sel);
+static void lcd_panel_init(u32 sel);
+static void lcd_panel_exit(u32 sel);
+
+/* lcd_gpio_0 = reset (PD22), lcd_gpio_1 = LED control (PB2), lcd_gpio_2 = second reset line (PB7) */
+#define panel_reset(sel, val) sunxi_lcd_gpio_set_value(sel, 0, val)
+#define LED_SET(sel, val) sunxi_lcd_gpio_set_value(sel, 1, val)
+
+static void lcd_cfg_panel_info(struct panel_extend_para *info)
+{
+	u32 i = 0, j = 0;
+	u32 items;
+	u8 lcd_gamma_tbl[][2] = {
+		{0, 0}, {15, 15}, {30, 30}, {45, 45}, {60, 60}, {75, 75},
+		{90, 90}, {105, 105}, {120, 120}, {135, 135}, {150, 150},
+		{165, 165}, {180, 180}, {195, 195}, {210, 210}, {225, 225},
+		{240, 240}, {255, 255},
+	};
+
+	u32 lcd_cmap_tbl[2][3][4] = {
+	{
+		{LCD_CMAP_G0, LCD_CMAP_B1, LCD_CMAP_G2, LCD_CMAP_B3},
+		{LCD_CMAP_B0, LCD_CMAP_R1, LCD_CMAP_B2, LCD_CMAP_R3},
+		{LCD_CMAP_R0, LCD_CMAP_G1, LCD_CMAP_R2, LCD_CMAP_G3},
+		},
+		{
+		{LCD_CMAP_B3, LCD_CMAP_G2, LCD_CMAP_B1, LCD_CMAP_G0},
+		{LCD_CMAP_R3, LCD_CMAP_B2, LCD_CMAP_R1, LCD_CMAP_B0},
+		{LCD_CMAP_G3, LCD_CMAP_R2, LCD_CMAP_G1, LCD_CMAP_R0},
+		},
+	};
+
+	items = sizeof(lcd_gamma_tbl) / 2;
+	for (i = 0; i < items - 1; i++) {
+		u32 num = lcd_gamma_tbl[i + 1][0] - lcd_gamma_tbl[i][0];
+
+		for (j = 0; j < num; j++) {
+			u32 value = 0;
+
+			value = lcd_gamma_tbl[i][1] +
+			    ((lcd_gamma_tbl[i + 1][1] - lcd_gamma_tbl[i][1]) * j) / num;
+			info->lcd_gamma_tbl[lcd_gamma_tbl[i][0] + j] =
+			    (value << 16) + (value << 8) + value;
+		}
+	}
+	info->lcd_gamma_tbl[255] = (lcd_gamma_tbl[items - 1][1] << 16) +
+	    (lcd_gamma_tbl[items - 1][1] << 8) + lcd_gamma_tbl[items - 1][1];
+
+	memcpy(info->lcd_cmap_tbl, lcd_cmap_tbl, sizeof(lcd_cmap_tbl));
+}
+
+static s32 lcd_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, lcd_power_on, 0);
+	LCD_OPEN_FUNC(sel, lcd_panel_init, 100);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 100);
+	LCD_OPEN_FUNC(sel, lcd_bl_open, 0);
+	return 0;
+}
+
+static s32 lcd_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, lcd_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, lcd_panel_exit, 0);
+	LCD_CLOSE_FUNC(sel, lcd_power_off, 0);
+	return 0;
+}
+
+static void lcd_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void lcd_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+static s32 lcd_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+#define panel_reset2(sel, val) sunxi_lcd_gpio_set_value(sel, 2, val)
+
+static void lcd_power_on(u32 sel)
+{
+	LED_SET(sel, 1);
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_power_enable(sel, 1);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_pin_cfg(sel, 1);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(80);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(80);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(80);
+	panel_reset2(sel, 1);
+	sunxi_lcd_delay_ms(20);
+	panel_reset2(sel, 0);
+	sunxi_lcd_delay_ms(20);
+	panel_reset2(sel, 1);
+}
+
+static void lcd_power_off(u32 sel)
+{
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 0);
+	panel_reset2(sel, 0);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 1);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 0);
+}
+
+/* The panel's own controller needs no register table: sleep out, then display on. */
+static void lcd_panel_init(u32 sel)
+{
+	sunxi_lcd_dsi_clk_enable(sel);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x11);
+	sunxi_lcd_delay_ms(120);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x29);
+}
+
+static void lcd_panel_exit(u32 sel)
+{
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x28);
+	sunxi_lcd_delay_ms(1);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x10);
+	sunxi_lcd_delay_ms(1);
+}
+
+struct __lcd_panel RTP40WV101B_panel = {
+	/* panel driver name, must match lcd_driver_name in the device tree */
+	.name = "RTP40WV101B",
+	.func = {
+		.cfg_panel_info = lcd_cfg_panel_info,
+		.cfg_open_flow = lcd_open_flow,
+		.cfg_close_flow = lcd_close_flow,
+		.lcd_user_defined_func = lcd_user_defined_func,
+	},
+};
