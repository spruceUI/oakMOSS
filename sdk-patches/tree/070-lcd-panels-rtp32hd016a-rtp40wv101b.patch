+/* drivers/video/fbdev/sunxi/disp2/disp/lcd/rtp32hd016a.c
+ *
+ * RTP32HD016A: 1024x768, two-lane MIPI-DSI, the panel of the MagicX XU20 V32.
+ *
+ * Recovered from the board's stock kernel (MagicX's public XU20_V32 developer release, kernel
+ * 4.9.170 "#1 SMP PREEMPT Mon Aug 18 2025"): the open/close flows, the power and reset
+ * sequence and the 31-entry DSI init table were read out of that binary's
+ * lcd_open_flow / lcd_power_on / lcd_panel_init / lcd_panel_exit /
+ * lcd_power_off routines and are reproduced here call for call, delays
+ * included. The panel timings live in the board device tree (lcd0), also
+ * taken from the stock tree. Gamma/cmap setup is the SDK's standard one.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+#include "rtp32hd016a.h"
+
+static void lcd_power_on(u32 sel);
+static void lcd_power_off(u32 sel);
+static void lcd_bl_open(u32 sel);
+static void lcd_bl_close(u32 sel);
+static void lcd_panel_init(u32 sel);
+static void lcd_panel_exit(u32 sel);
+
+/* lcd_gpio_0 = reset (PD22), lcd_gpio_1 = LED control (PB2) */
+#define panel_reset(sel, val) sunxi_lcd_gpio_set_value(sel, 0, val)
+#define LED_SET(sel, val) sunxi_lcd_gpio_set_value(sel, 1, val)
+
+static void lcd_cfg_panel_info(struct panel_extend_para *info)
+{
+	u32 i = 0, j = 0;
+	u32 items;
+	u8 lcd_gamma_tbl[][2] = {
+		{0, 0}, {15, 15}, {30, 30}, {45, 45}, {60, 60}, {75, 75},
+		{90, 90}, {105, 105}, {120, 120}, {135, 135}, {150, 150},
+		{165, 165}, {180, 180}, {195, 195}, {210, 210}, {225, 225},
+		{240, 240}, {255, 255},
+	};
+
+	u32 lcd_cmap_tbl[2][3][4] = {
+	{
+		{LCD_CMAP_G0, LCD_CMAP_B1, LCD_CMAP_G2, LCD_CMAP_B3},
+		{LCD_CMAP_B0, LCD_CMAP_R1, LCD_CMAP_B2, LCD_CMAP_R3},
+		{LCD_CMAP_R0, LCD_CMAP_G1, LCD_CMAP_R2, LCD_CMAP_G3},
+		},
+		{
+		{LCD_CMAP_B3, LCD_CMAP_G2, LCD_CMAP_B1, LCD_CMAP_G0},
+		{LCD_CMAP_R3, LCD_CMAP_B2, LCD_CMAP_R1, LCD_CMAP_B0},
+		{LCD_CMAP_G3, LCD_CMAP_R2, LCD_CMAP_G1, LCD_CMAP_R0},
+		},
+	};
+
+	items = sizeof(lcd_gamma_tbl) / 2;
+	for (i = 0; i < items - 1; i++) {
+		u32 num = lcd_gamma_tbl[i + 1][0] - lcd_gamma_tbl[i][0];
+
+		for (j = 0; j < num; j++) {
+			u32 value = 0;
+
+			value = lcd_gamma_tbl[i][1] +
+			    ((lcd_gamma_tbl[i + 1][1] - lcd_gamma_tbl[i][1]) * j) / num;
+			info->lcd_gamma_tbl[lcd_gamma_tbl[i][0] + j] =
+			    (value << 16) + (value << 8) + value;
+		}
+	}
+	info->lcd_gamma_tbl[255] = (lcd_gamma_tbl[items - 1][1] << 16) +
+	    (lcd_gamma_tbl[items - 1][1] << 8) + lcd_gamma_tbl[items - 1][1];
+
+	memcpy(info->lcd_cmap_tbl, lcd_cmap_tbl, sizeof(lcd_cmap_tbl));
+}
+
+static s32 lcd_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, lcd_power_on, 0);
+	LCD_OPEN_FUNC(sel, lcd_panel_init, 100);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 100);
+	LCD_OPEN_FUNC(sel, lcd_bl_open, 0);
+	return 0;
+}
+
+static s32 lcd_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, lcd_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, lcd_panel_exit, 20);
+	LCD_CLOSE_FUNC(sel, lcd_power_off, 0);
+	return 0;
+}
+
+static void lcd_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void lcd_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+static s32 lcd_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+static void lcd_power_on(u32 sel)
+{
+	LED_SET(sel, 1);
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_power_enable(sel, 1);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_pin_cfg(sel, 1);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(20);
+}
+
+static void lcd_power_off(u32 sel)
+{
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 1);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 0);
+	LED_SET(sel, 1);
+}
+
+#define REGFLAG_DELAY 0xFE
+#define REGFLAG_END_OF_TABLE 0xFD
+struct LCM_setting_table {
+	u8 cmd;
+	u32 count;
+	u8 para_list[48];
+};
+
+/* Verbatim from the stock kernel's table (56-byte entries: cmd, count at +4,
+ * parameters at +8). Note the two REGFLAG_DELAY rows carry their value in
+ * the COUNT field, not in para_list[0]: with this loop, which is the stock
+ * loop, they are therefore sent as DCS command 0xfe with 120 / 20 bytes
+ * (the row's 48 zeros followed by the next rows' bytes, exactly as the
+ * stock binary reads past its own row) and no delay elapses. That is what the shipped driver does and what
+ * the panel is known to accept; kept as is on purpose. */
+static struct LCM_setting_table LCM_rtp32hd016a_setting[] = {
+	{0xdf,   3, {0x91, 0x68, 0xf9}},
+	{0xde,   1, {0x00}},
+	{0xb2,   2, {0x00, 0x7e}},
+	{0xb3,   2, {0x00, 0x7e}},
+	{0xc1,   6, {0x00, 0x08, 0x00, 0x00, 0x00, 0x00}},
+	{0xbb,   7, {0x02, 0x24, 0x07, 0x61, 0x19, 0x44, 0x44}},
+	{0xbe,   2, {0x1a, 0xf2}},
+	{0xc3,  14, {0x10, 0x17, 0x5a, 0x17, 0x5a, 0x05, 0x05, 0x05, 0x05, 0x15, 0x15, 0x31, 0x05, 0xdf}},
+	{0xc4,   7, {0x11, 0x80, 0x00, 0xdf, 0x09, 0x06, 0x14}},
+	{0xce,  23, {0x00, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x0f, 0x03}},
+	{0xcf,   9, {0x00, 0x01, 0x40, 0x01, 0xca, 0x01, 0xca, 0x01, 0xca}},
+	{0xd0,  23, {0x00, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x03, 0x01, 0x05, 0x07, 0x09, 0x0b, 0x1e, 0x15, 0x1f, 0x1f, 0x15, 0x1f}},
+	{0xd1,  23, {0x00, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x02, 0x00, 0x04, 0x06, 0x08, 0x0a, 0x1e, 0x15, 0x1f, 0x1f, 0x15, 0x1f}},
+	{0xd2,  23, {0x00, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x00, 0x02, 0x0a, 0x08, 0x06, 0x04, 0x1f, 0x15, 0x1f, 0x1f, 0x15, 0x1e}},
+	{0xd3,  23, {0x00, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x1f, 0x01, 0x03, 0x0b, 0x09, 0x07, 0x05, 0x1f, 0x15, 0x1f, 0x1f, 0x15, 0x1e}},
+	{0xd4,  37, {0x30, 0x00, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x03, 0x00, 0x11, 0x00, 0x01, 0xc0, 0x04, 0x01, 0x01, 0x11, 0x80, 0x01, 0xc0, 0x05, 0x01, 0x01, 0x00, 0x00, 0x00, 0x04, 0x00, 0x06, 0x18, 0x02, 0xe3}},
+	{0xd5,   8, {0x68, 0x73, 0x00, 0x08, 0x08, 0x00, 0x03, 0x00}},
+	{0xb7,   6, {0x00, 0xd8, 0x00, 0x00, 0xd8, 0x00}},
+	{0xc8,  38, {0x7f, 0x69, 0x5a, 0x4e, 0x4a, 0x3b, 0x40, 0x2a, 0x44, 0x43, 0x44, 0x63, 0x51, 0x59, 0x4c, 0x48, 0x3a, 0x28, 0x0f, 0x7f, 0x69, 0x5a, 0x4e, 0x4a, 0x3b, 0x40, 0x2a, 0x44, 0x43, 0x44, 0x63, 0x51, 0x59, 0x4c, 0x48, 0x3a, 0x28, 0x0f}},
+	{0xde,   1, {0x02}},
+	{0xbb,   4, {0x00, 0x5b, 0x5c, 0x41}},
+	{0xc6,   1, {0x22}},
+	{0xd7,   1, {0x12}},
+	{0xde,   1, {0x04}},
+	{0xcc,   1, {0x35}},
+	{0xe7,   1, {0x01}},
+	{0xde,   1, {0x00}},
+	{0x11,   0, {}},
+	{0xfe, 120, {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+	{0x29,   0, {}},
+	{0xfe,  20, {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+	{REGFLAG_END_OF_TABLE, REGFLAG_END_OF_TABLE, {}}
+};
+
+static void lcd_panel_init(u32 sel)
+{
+	u32 i = 0;
+
+	sunxi_lcd_dsi_clk_enable(sel);
+	for (i = 0;; i++) {
+		if (LCM_rtp32hd016a_setting[i].count == REGFLAG_END_OF_TABLE)
+			break;
+		else if (LCM_rtp32hd016a_setting[i].count == REGFLAG_DELAY)
+			sunxi_lcd_delay_ms(LCM_rtp32hd016a_setting[i].para_list[0]);
+		else
+			sunxi_lcd_dsi_dcs_write(sel, LCM_rtp32hd016a_setting[i].cmd,
+						LCM_rtp32hd016a_setting[i].para_list,
+						LCM_rtp32hd016a_setting[i].count);
+	}
+}
+
+static void lcd_panel_exit(u32 sel)
+{
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x10);
+	sunxi_lcd_delay_ms(20);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x28);
+	sunxi_lcd_delay_ms(20);
+}
+
+struct __lcd_panel RTP32HD016A_panel = {
+	/* panel driver name, must match lcd_driver_name in the device tree */
+	.name = "RTP32HD016A",
+	.func = {
+		.cfg_panel_info = lcd_cfg_panel_info,
+		.cfg_open_flow = lcd_open_flow,
+		.cfg_close_flow = lcd_close_flow,
+		.lcd_user_defined_func = lcd_user_defined_func,
+	},
+};
