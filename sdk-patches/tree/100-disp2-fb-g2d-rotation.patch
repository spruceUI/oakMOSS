+int fb_get_rot_degree(unsigned int fb_id)
+{
+	int ret = -1;
+	struct device_node *node;
+	char primary_key[20];
+	char sub_name[32] = {0};
+	unsigned int value = 0;
+
+	sprintf(primary_key, "%s", "disp");
+	node = of_find_node_by_name(NULL, primary_key);
+	if (node == NULL) {
+		pr_err("%s find node failed\n", __func__);
+		return -1;
+	}
+	ret = of_property_read_u32(node, "disp_rotation_used", &value);
+
+	if (ret || !value) {
+		pr_warn("rotation hw function is configed as no used\n");
+		return -1;
+	}
+
+	sprintf(sub_name, "degree%d", fb_id);
+	ret = of_property_read_u32(node, sub_name, &value);
+	if (ret || value == FB_ROTATION_HW_0) {
+		pr_warn("rotation hw function is configed to zero degree\n");
+		return -1;
+	}
+
+	return value;
+}
