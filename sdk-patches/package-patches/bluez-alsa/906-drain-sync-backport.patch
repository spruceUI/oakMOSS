 int ba_transport_pcm_drain(struct ba_transport_pcm *pcm) {
 
-	if (pthread_equal(pcm->th->id, config.main_thread))
+	struct ba_transport_thread *th = pcm->th;
+
+	if (pthread_equal(th->id, config.main_thread))
 		return errno = ESRCH, -1;
 
 	pthread_mutex_lock(&pcm->synced_mtx);
 
-	ba_transport_thread_signal_send(pcm->th, BA_TRANSPORT_THREAD_SIGNAL_PCM_SYNC);
-	pthread_cond_wait(&pcm->synced, &pcm->synced_mtx);
+	/* An IO thread which has already exited keeps its ID until the main
+	 * thread joins it, so check its state as well. The thread cleanup
+	 * marks the PCM as synced only after the state has been reset, so if
+	 * the thread is still running here, the wake-up is still to come. */
+	pthread_mutex_lock(&th->state_mtx);
+	const bool running = th->state == BA_TRANSPORT_THREAD_STATE_RUNNING;
+	pthread_mutex_unlock(&th->state_mtx);
+	if (!running) {
+		pthread_mutex_unlock(&pcm->synced_mtx);
+		return errno = ESRCH, -1;
+	}
 
+	pcm->synced = false;
+	ba_transport_thread_signal_send(th, BA_TRANSPORT_THREAD_SIGNAL_PCM_SYNC);
+
+	while (!pcm->synced)
+		pthread_cond_wait(&pcm->synced_cond, &pcm->synced_mtx);
+
 	pthread_mutex_unlock(&pcm->synced_mtx);
 
