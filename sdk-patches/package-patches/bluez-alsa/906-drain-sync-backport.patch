+	/* The thread may have been terminated while a PCM drain operation is in
+	 * progress. To prevent ba_transport_pcm_drain() from blocking forever,
+	 * we signal that drain is no longer in progress. */
+	struct ba_transport_pcm *pcms[2] = { NULL, NULL };
+	if (t->type.profile & BA_TRANSPORT_PROFILE_MASK_A2DP) {
+		pcms[0] = &t->a2dp.pcm;
+		pcms[1] = &t->a2dp.pcm_bc;
+	}
+	else if (t->type.profile & BA_TRANSPORT_PROFILE_MASK_SCO) {
+		pcms[0] = &t->sco.spk_pcm;
+		pcms[1] = &t->sco.mic_pcm;
+	}
+	for (size_t i = 0; i < ARRAYSIZE(pcms); i++)
+		if (pcms[i] != NULL && pcms[i]->th == th) {
+			pthread_mutex_lock(&pcms[i]->synced_mtx);
+			pcms[i]->synced = true;
+			pthread_mutex_unlock(&pcms[i]->synced_mtx);
+			pthread_cond_signal(&pcms[i]->synced_cond);
+		}
+
 	/* Remove reference which was taken by the ba_transport_thread_create(). */
 	ba_transport_unref(t);
 }
