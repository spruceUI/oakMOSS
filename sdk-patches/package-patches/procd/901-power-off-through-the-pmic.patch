The firmware's power-off (PSCI SYSTEM_OFF, ATF and SCP) sometimes leaves the AXP2202 on: the
board stays up dark and warm until the power key is held (Zero 28, 2026-10-11, 65% to 6% in
23 h; the "limbo" state MinUI and NextUI fixed on the TrimUI Brick). At a power-off, procd now
runs /usr/magicx/bin/oakmoss-pmic-off after the last kill and sync, before the firmware's call,
which still follows when the script returns. The K scripts get OAKMOSS_SHUTDOWN=poweroff|reboot.
--- a/state.c
+++ b/state.c
@@ -18,6 +18,7 @@
 #include <stdlib.h>
 #include <unistd.h>
 #include <sys/types.h>
+#include <sys/wait.h>
 #include <signal.h>
 
 #include "procd.h"
@@ -41,6 +42,8 @@
 static int state = STATE_NONE;
 static int reboot_event;
 
+#define PMIC_OFF "/usr/magicx/bin/oakmoss-pmic-off"
+
 static void set_stdio(const char* tty)
 {
 	if (chdir("/dev") ||
@@ -172,6 +175,23 @@
 		else
 			LOG("- reboot -\n");
 
+		/* oakMOSS: switch the PMIC off directly; it returns only when it did not, and the
+		 * firmware's power-off below runs as before (5 s cap on a script that hangs). */
+		if (reboot_event == RB_POWER_OFF && !access(PMIC_OFF, X_OK)) {
+			pid_t off = fork();
+			int i;
+
+			if (!off) {
+				signal(SIGCHLD, SIG_DFL);	/* SIG_IGN survives exec; the script waits on its own */
+				execl(PMIC_OFF, PMIC_OFF, (char *) NULL);
+				_exit(EXIT_FAILURE);
+			}
+			for (i = 0; off > 0 && i < 50 && !waitpid(off, NULL, WNOHANG); i++)
+				usleep(100000);
+			if (off > 0 && i == 50)
+				kill(off, SIGKILL);
+		}
+
 		/* Allow time for last message to reach serial console, etc */
 		//sleep(1);
 
@@ -212,6 +232,8 @@
 		return;
 	DEBUG(2, "Shutting down system with event %x\n", event);
 	reboot_event = event;
+	/* oakMOSS: the K scripts can tell a power-off from a reboot */
+	setenv("OAKMOSS_SHUTDOWN", event == RB_POWER_OFF ? "poweroff" : "reboot", 1);
 	state = STATE_SHUTDOWN;
 	state_enter();
 }
