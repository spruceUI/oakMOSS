# Large or proprietary inputs and everything derived from them (see README.md).
# inputs/ holds the SDK zip, the vendor encrypt object and the stock firmware
# images; none of them are redistributable, all of them are fetched or supplied
# by the builder. The two small manifests below ARE part of the build.
/inputs/*
!/inputs/README.md
!/inputs/xu20-pvr-1.11.sha256
# The userland lanes' provenance lists are tracked; the tarballs they name are fetched and verified from them.
!/inputs/userland/
/inputs/userland/*
!/inputs/userland/urls.txt
!/inputs/userland/SHA256SUMS

# Work trees: unpacked SDK, toolchains, host tools, build outputs.
/sdk/
/toolchains/
/tools/
/builds/

# CI collects release artefacts here before uploading them.
/out/

# Vendor kernel encrypt objects, copied in by the build. A pattern, not one exact
# path: these are MagicX's proprietary security-chip objects and a per-board name
# variant must not become committable by being spelled differently.
/boards/*/encrypt
/boards/*/encrypt.*

# Local drop-in boot logo (see ATTRIBUTION.md, "Boot logo"). Covers a renamed or a
# second logo too: nothing in overlay/ should acquire an image by accident.
/overlay/*.bmp

# Build and download leftovers, including the byproducts of applying patches to the
# unpacked SDK (this repository's own workflow produces .orig and .rej files).
*.orig
*.rej
*.bak
*.part
*.tmp
*.log
core
core.[0-9]*
*.o
*.ko
*.img
*.img.xz
*.fex
# ...except a board's own sys_config, which build.sh installs when a board has one.
!/boards/*/sys_config.fex
# Card read-backs in any tool's format (a DiskGenius .pmfx is a whole card):
# they carry the reader's data and vendor partitions, never this repository's.
*.pmfx

# Python.
__pycache__/
*.py[cod]

# Local environment and secrets. Nothing in this repository should ever need
# one, but an accidental .env must not be committable.
.env
.env.*
*.pem
*.key
!sdk-patches/**/*.key

# Editor and OS cruft.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
