#!/bin/sh /etc/rc.common
# TrimUI boards (docs/trimui.md): the GPIO lines stock runtrimui.sh sets (/usr/magicx/trimui-gpio, one
# N=1|0|in per line), then TrimUI's input daemon when the image carries it (a local image). Elsewhere a no-op.

START=14
USE_PROCD=1

start_service() {
	if [ -f /usr/magicx/trimui-gpio ]; then
		while read -r l; do
			n=${l%%=*}; v=${l#*=}
			[ -d "/sys/class/gpio/gpio$n" ] || echo "$n" > /sys/class/gpio/export 2>/dev/null
			# high/low set the level with the direction, without the glitch of out-then-value
			case $v in in) d=in ;; 1) d=high ;; *) d=low ;; esac
			echo "$d" > "/sys/class/gpio/gpio$n/direction" 2>/dev/null
		done < /usr/magicx/trimui-gpio
	fi
	[ -x /usr/trimui/bin/trimui_inputd ] || return 0
	mkdir -p /tmp/trimui_inputd
	procd_open_instance
	procd_set_param command /usr/trimui/bin/trimui_inputd
	procd_set_param respawn
	procd_close_instance
}
